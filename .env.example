# 거산 영업지원 — 환경 변수 예시. 복사해서 .env로 쓰되 .env는 커밋하지 않는다.
# 실제 값은 실행 환경에서 설정한다. 이 파일을 자동으로 읽지는 않는다.

# SQLite 파일 경로. 비워 두면 ./data/geosan.db
GEOSAN_DB_PATH=./data/geosan.db

# accessProtection.enabled가 true일 때 필수. 실제 값은 커밋하지 않는다.
GEOSAN_PASSWORD=

# 홈페이지 찾기·근거 추출용. PM 결정 B에 따라 네이버 키는 사용하지 않는다.
OPENAI_API_KEY=

# 산단공 공장등록 조회용(공공데이터포털 15087611). 실제 값은 실행 환경에만 넣는다.
DATA_GO_KR_SERVICE_KEY=

# 좌표 조회용. 도로명주소 검색과 좌표제공의 승인키는 서로 다르다(#222).
JUSO_SEARCH_KEY=
JUSO_COORD_KEY=

# 네이버 Geocoding 서버용. 지도 화면용 Client ID와 별개로 서버에만 전달한다.
NCP_MAPS_KEY_ID=
NCP_MAPS_KEY=

# 대시보드 네이버 지도(#671)는 화면을 빌드할 때 web/.env의 VITE_NCP_MAPS_CLIENT_ID를 읽는다(이 파일이 아님).
# 값은 위 NCP_MAPS_KEY_ID와 같은 Client ID. 비밀은 아니며 콘솔의 Web 서비스 URL로 보호한다. Client Secret은 넣지 않는다.
# 콘솔에서 Dynamic Map을 켜고 Web 서비스 URL(예: http://127.0.0.1:8000)을 등록해야 지도가 열린다. 없으면 자리표시로 보인다.
