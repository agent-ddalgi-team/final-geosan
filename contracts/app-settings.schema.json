{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geosan.local/contracts/app-settings.schema.json",
  "title": "AppSettings — 앱 설정 파일 (계약 C7, YAML)",
  "description": "담당자 목록·활성 거산 값 묶음·수집 범위·LLM 모드·브랜드·접속 보호. 비밀번호·API 키는 적지 않는다(password·apiKey·token 키는 check-config가 거부). `_설명` 키는 어느 객체에든 허용된다. 더하는 변경(2026-10-21 PM 확인): brand.demoLabel.",
  "type": "object",
  "required": ["staff", "activeDatasetKind", "ingestion", "llm", "homepageDiscovery", "brand", "accessProtection"],
  "additionalProperties": false,
  "properties": {
    "geosan": {
      "type": "object",
      "additionalProperties": false,
      "description": "거산 기준 주소와 좌표(C7 #222). 좌표는 준비 전 함께 null.",
      "properties": {
        "address": {
          "type": "string"
        },
        "lat": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "_설명": {
          "type": "string"
        }
      }
    },
    "geocoding": {
      "type": "object",
      "additionalProperties": false,
      "description": "2026-11-13 확인: CSV 우선·행안부 보완·네이버 실시간 전용. 키는 환경변수.",
      "properties": {
        "provider": {
          "const": "JUSO",
          "default": "JUSO"
        },
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "dailyCallLimit": {
          "type": "integer",
          "minimum": 1,
          "default": 10000
        },
        "locationCsvFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "locationCsvBaseDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "default": null
        },
        "naverFallbackEnabled": {
          "type": "boolean",
          "default": false
        },
        "_설명": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "locationCsvFiles"
            ],
            "properties": {
              "locationCsvFiles": {
                "minItems": 1
              }
            }
          },
          "then": {
            "required": [
              "locationCsvBaseDate"
            ],
            "properties": {
              "locationCsvBaseDate": {
                "type": "string",
                "format": "date"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "naverFallbackEnabled"
            ],
            "properties": {
              "naverFallbackEnabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "distanceFilterPresetsKm": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "default": [
        30,
        50,
        100
      ]
    },
    "candidateWebSearch": {
      "type": "object",
      "additionalProperties": false,
      "description": "후보 웹 검색 독립 설정(C7, #314 2026-11-09 PM 승인). 하위 도메인도 차단한다.",
      "properties": {
        "_설명": { "type": "string" },
        "enabled": { "type": "boolean", "default": false },
        "dailySearchLimit": { "type": "integer", "minimum": 0, "default": 20 },
        "cacheDays": { "type": "integer", "minimum": 1, "default": 15 },
        "blockedDomains": {
          "type": "array", "maxItems": 100, "uniqueItems": true, "default": [],
          "items": { "type": "string", "pattern": "^(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,}$" }
        }
      },
      "allOf": [{
        "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
        "then": { "required": ["blockedDomains"], "properties": { "blockedDomains": { "minItems": 1 } } }
      }]
    },
    "records": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "_설명": { "type": "string" },
        "approvalEnabled": { "type": "boolean", "default": false },
        "noteMaxLength": { "type": "integer", "minimum": 1, "default": 200 }
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "_설명": { "type": "string" },
        "staleAfterDays": { "type": "integer", "minimum": 1, "default": 90 },
        "autoOnBookmarkDailyCostUsd": { "type": "number", "minimum": 0, "default": 0, "description": "(추가 2026-11-13 #690) 관심을 켜서 저절로 도는 조사가 하루(한국 시간)에 쓸 수 있는 AI 비용(달러). 오늘 쓴 금액이 이 값보다 적을 때만 새 조사를 시작한다(마지막 한 곳만큼은 넘을 수 있다). 예시 설정 1.0, 0이면 꺼짐. 이 칸이 없는 옛 설정 사본은 예시 파일 값으로 읽는다." },
        "suggestAgainAfterDays": { "type": "integer", "minimum": 0, "default": 0, "description": "(추가 2026-11-14 #677) AI가 조사한 지 이 일수보다 오래 지난 관심 회사의 상세에 다시 조사를 제안한다(C1 header.researchSuggestAgain). 알리기만 하고 저절로 조사하지 않는다. 예시 설정 30, 0이면 제안하지 않음. 이 칸이 없는 옛 설정 사본은 예시 파일 값으로 읽는다." }
      }
    },
    "salesAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minSampleForRatio", "closedWindowDays"],
      "description": "영업 분석표(C1 /sales-analysis, #608) 기준 숫자. 이 묶음이 없는 옛 설정은 예시 파일(examples/app-settings.yaml) 값으로 읽는다.",
      "properties": {
        "_설명": { "type": "string" },
        "minSampleForRatio": { "type": "integer", "minimum": 1, "description": "표본(접촉한 곳 수)이 이보다 적으면 비율 없이 건수와 \"표본 n건\"만 보인다. 초기값 10" },
        "closedWindowDays": { "type": "integer", "minimum": 1, "description": "성사·거절은 결과 기록이 이 일수 안인 것만 센다. 초기값 365" }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "description": "내보내기 스위치(#217, PM 결정 2026-11-13). 이 묶음이 없는 옛 설정 파일은 꺼짐으로, 옛 DB 사본은 예시 파일(examples/app-settings.yaml) 값으로 읽는다.",
      "properties": {
        "_설명": { "type": "string" },
        "xlsxEnabled": { "type": "boolean", "default": false, "description": "true면 [영업 후보 목록]의 [엑셀 내려받기] 단추가 보이고 내려받기 창구(C1 GET /export/xlsx)가 열린다. false면 단추를 숨기고 창구는 422 kind EXPORT_DISABLED로 막는다. 초기값 false(만들어 두고 꺼 둠, 거산이 필요하다고 하면 켠다). 켜기 전에 내려받은 기록 1행(C4 TransferLog)을 먼저 만든다. 그 기록이 만들어지기 전에는 true를 설정 검사가 거부한다" }
      }
    },
    "contactList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nowClassifications", "unscoredHighFitToNow", "nullFitLevelAs", "adjust"],
      "description": "추천 목록 세 묶음(C1 sort=contact·카드 bucket·rankAdjust, #610) 기준. 이 묶음이 없는 옛 설정은 예시 파일(examples/app-settings.yaml) 값으로 읽는다. 부록 F 점수·분류·기존 순위는 바꾸지 않는다.",
      "properties": {
        "_설명": { "type": "string" },
        "nowClassifications": {
          "type": "array",
          "items": { "type": "string", "enum": ["FILTER_EXCLUDED", "FILTER_PENDING", "OPS_PENDING", "NOT_EVALUATED", "CONTACT_URGENT", "CONTACT_PLANNED", "CONTACT_REVIEW", "RESEARCH", "CONDITIONAL_WAIT", "WATCH", "LOW"] },
          "description": "막는 조건이 없을 때 \"지금 연락할 곳\"에 드는 분류. 초기값 CONTACT_URGENT, CONTACT_PLANNED, RESEARCH, CONDITIONAL_WAIT. 필수 탈락·제외 의견·거래 중인 회사는 이 값과 무관하게 들지 않는다"
        },
        "unscoredHighFitToNow": { "type": "boolean", "description": "true면 평가 전 + 적합도 상 회사를 \"지금 연락할 곳\"에 넣는다. 초기값 false(확인 필요에 둔다)" },
        "nullFitLevelAs": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"], "description": "적합도가 없는 회사(사례 파일로 넣은 회사)를 묶음 안 순서에서 어느 적합도로 볼지. 초기값 HIGH" },
        "adjust": {
          "type": "object",
          "additionalProperties": false,
          "required": ["windowDays", "minClosedCount", "wonPerStep", "maxUp", "lostPerStep", "maxDown", "lostReasonsCounted"],
          "description": "같은 공정·산업군의 최근 성사·거절로 묶음 안 순서를 올리거나 내리는 기준. 묶음을 넘지 않는다.",
          "properties": {
            "_설명": { "type": "string" },
            "windowDays": { "type": "integer", "minimum": 1, "description": "결과 기록이 이 일수 안인 성사·거절만 센다. 초기값 365" },
            "minClosedCount": { "type": "integer", "minimum": 1, "description": "표본(성사 + 센 거절)이 이보다 적으면 조정하지 않는다. 초기값 5" },
            "wonPerStep": { "type": "integer", "minimum": 1, "description": "성사 이 수마다 한 단계 위로. 초기값 2" },
            "maxUp": { "type": "integer", "minimum": 0, "description": "위로는 최대 이 단계까지. 초기값 2" },
            "lostPerStep": { "type": "integer", "minimum": 1, "description": "센 거절 이 수마다 한 단계 아래로. 초기값 3" },
            "maxDown": { "type": "integer", "minimum": 0, "description": "아래로는 최대 이 단계까지. 초기값 1" },
            "lostReasonsCounted": {
              "type": "array",
              "items": { "type": "string", "enum": ["PRICE", "LEAD_TIME", "INCUMBENT_SUPPLIER", "NO_DEMAND", "QUALITY_CERT", "OTHER"] },
              "description": "이 이유의 거절만 센다. 초기값 NO_DEMAND(수요 없음), QUALITY_CERT(품질·인증 요건)"
            }
          }
        }
      }
    },
    "listFilters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "_설명": { "type": "string" },
        "regionPresets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "cities"],
            "additionalProperties": false,
            "properties": {
              "_설명": { "type": "string" },
              "label": { "type": "string" },
              "cities": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "industries": { "type": "array", "items": { "type": "string" }, "description": "산업군 선택지. 순서는 목록의 산업군 건수 표시 순서 (2026-11-03 PM 승인)" },
    "_설명": { "type": "string" },
    "staff": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "displayName"],
        "additionalProperties": false,
        "properties": {
          "_설명": { "type": "string" },
          "key": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$", "description": "C0 staffKey. 예약 키 viewer는 보기 전용" },
          "displayName": { "type": "string", "minLength": 1 }
        }
      }
    },
    "activeDatasetKind": { "type": "string", "enum": ["VIRTUAL_REVIEWED", "BROCHURE", "COMPANY_CONFIRMED"] },
    "ingestion": {
      "type": "object",
      "required": ["regions", "productKeywords", "maxCandidates", "costEstimate"],
      "additionalProperties": false,
      "properties": {
        "_설명": { "type": "string" },
        "regions": { "type": "array", "items": { "type": "string" } },
        "productKeywords": { "type": "array", "items": { "type": "string" } },
        "maxCandidates": { "type": "integer", "minimum": 1 },
        "costEstimate": {
          "type": "object",
          "required": ["judgeUsdPerRow", "researchUsdPerCompany", "researchCallsPerCompany", "webSearchUsdPerBatch"],
          "additionalProperties": false,
          "description": "누르기 전 예상 금액·잠금 계산에만 쓰는 단가(PM 결정 #549). 실제 한도 검사는 전송 기록으로 한다. 모두 0보다 큼.",
          "properties": {
            "_설명": { "type": "string" },
            "judgeUsdPerRow": { "type": "number", "exclusiveMinimum": 0, "description": "공장 1행 AI 판단 금액. 초기 0.002." },
            "researchUsdPerCompany": { "type": "number", "exclusiveMinimum": 0, "description": "회사 1곳 자동 조사 금액. 초기 0.04." },
            "researchCallsPerCompany": { "type": "integer", "exclusiveMinimum": 0, "description": "회사 1곳 조사의 호출 수. 초기 2." },
            "webSearchUsdPerBatch": { "type": "number", "exclusiveMinimum": 0, "description": "후보 웹 검색 1회 금액. 초기 0.04." }
          }
        },
        "factoryCsvPath": { "type": "string", "default": "", "description": "공장현황 CSV 경로. 비어 있으면 후보 찾기를 실행할 수 없다. 파일명 또는 바로 위 폴더에 기준일 YYYYMMDD가 있어야 한다(PM #427)." },
        "aiPick": {
          "type": "object",
          "additionalProperties": false,
          "description": "후보 판단 설정. PM 승인 #425·#430, 지시문 pick-v1.",
          "properties": {
            "_설명": { "type": "string" },
            "enabled": { "type": "boolean", "default": false },
            "rowsPerCall": { "type": "integer", "minimum": 1, "default": 20, "description": "한 번에 AI에 보내는 공장 행 수. 100행은 60초 한도를 넘겨 20으로 낮춤(PM #491, 2026-11-09)." },
            "promptFile": { "type": "string", "minLength": 1, "default": "examples/prompts/candidate-pick.md" },
            "surfaceTreatmentIndustryNames": { "type": "array", "items": { "type": "string" }, "default": [] },
            "surfaceTreatmentIndustryCodes": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{5}$" }, "default": [], "description": "팩토리온 업종번호(표준산업분류 5자리). 하나라도 있으면 표면처리 표시(PM 승인 #573). 예: 25922 도금업, 25923 도장 및 기타 피막처리업." },
            "model": { "type": ["string", "null"], "minLength": 1, "default": null, "description": "후보 고르기에만 쓸 모델. llm.allowedModels 안의 이름. 비우면 llm.model(PM #491, 모델 비교용)." },
            "excludeKeywords": { "type": "array", "items": { "type": "string" }, "description": "생산품·업종명에 이 말이 있고 제조 낌새가 없으면 AI에 보내지 않고 '제조업 아님'으로 기록(PM #491). 기본 목록은 코드의 DEFAULT_PICK_EXCLUDE_KEYWORDS." }
          }
        },
        "complexList": {
          "type": "object",
          "additionalProperties": false,
          "description": "단지 입주 목록 조회 설정. 기본값은 PM 결정(#393·#394, cacheDays 15는 2026-11-08 #405).",
          "properties": {
            "_설명": { "type": "string" },
            "enabled": { "type": "boolean", "default": false },
            "cacheDays": { "type": "integer", "minimum": 1, "default": 15 },
            "extraNames": { "type": "array", "items": { "type": "string" }, "default": [] }
          }
        }
      }
    },
    "llm": {
      "type": "object",
      "required": ["mode", "model", "monthlyCallLimit", "costPerThousandTokens"],
      "additionalProperties": false,
      "properties": {
        "_설명": { "type": "string" },
        "mode": { "type": "string", "enum": ["EXTERNAL", "NONE"] },
        "model": { "type": ["string", "null"] },
        "provider": { "type": "string", "enum": ["OPENAI"], "default": "OPENAI" },
        "allowedModels": { "type": "array", "items": { "type": "string" }, "default": [] },
        "inputCostPerMillionTokens": { "type": "number", "minimum": 0, "default": 0 },
        "outputCostPerMillionTokens": { "type": "number", "minimum": 0, "default": 0 },
        "webSearchCostPerThousandCalls": { "type": "number", "minimum": 0, "default": 0 },
        "monthlyCostLimitUsd": { "type": "number", "minimum": 0, "default": 0 },
        "costAlertRatio": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
        "monthlyCallLimit": { "type": "integer", "minimum": 0 },
        "costPerThousandTokens": { "type": "number", "minimum": 0 }
      }
    },
    "mainPhone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedPrefixes"],
      "properties": {
        "_설명": { "type": "string" },
        "allowedPrefixes": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{2,4}$" } }
      }
    },
    "homepageDiscovery": {
      "type": "object",
      "required": ["enabled", "termsConfirmed"],
      "additionalProperties": false,
      "properties": {
        "_설명": { "type": "string" },
        "enabled": { "type": "boolean" },
        "termsConfirmed": { "type": "boolean" },
        "minConfidence": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.7 },
        "autoResearch": { "type": "boolean", "default": false, "description": "새 사례를 투입하면 자동으로 조사할지 선택한다. 기존 설정에서 생략하면 자동 조사를 시작하지 않는다." },
        "dailyCallLimit": { "type": "integer", "minimum": 0, "default": 200 }
      }
    },
    "brand": {
      "type": "object",
      "required": ["logoUrl", "brandName", "colorPrimary", "demoLabel"],
      "additionalProperties": false,
      "properties": {
        "_설명": { "type": "string" },
        "logoUrl": { "type": ["string", "null"] },
        "brandName": { "type": "string", "minLength": 1 },
        "colorPrimary": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "demoLabel": { "type": ["string", "null"], "description": "띠에 함께 보이는 문구. 예: 부분 시연·거산 확인 전" }
      }
    },
    "accessProtection": {
      "type": "object",
      "required": ["enabled"],
      "additionalProperties": false,
      "properties": {
        "_설명": { "type": "string" },
        "enabled": { "type": "boolean" }
      }
    }
  }
}
