{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geosan.local/contracts/rule-config.schema.json",
  "title": "RuleConfig — 규칙 설정 파일 (계약 C7, YAML)",
  "description": "모든 수치는 기업 승인 전 가설이며 코드가 아니라 이 파일에 둔다(BR7.6). 값을 바꾸면 version을 올린다. `_설명` 키는 어느 객체에든 허용된다. 더하는 변경(2026-10-21 PM 확인): otherGroupSort. 더하는 변경(2026-11-13 PM 결정, #685): callSignals.",
  "type": "object",
  "required": ["version", "hypothesisNote", "newProfileItems", "recontactProfileItems", "certainty", "generalDecay", "recontactDates", "thresholds", "rounding", "coreEvidence", "timingRequirements", "researchRequirements", "classificationLabels", "otherGroupSort", "datasetKinds"],
  "additionalProperties": false,
  "properties": {
    "_설명": { "type": "string" },
    "version": { "type": "string", "minLength": 1, "description": "예: v0.17-a" },
    "hypothesisNote": { "type": "string", "const": "기업 승인 전 가설" },
    "newProfileItems": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/profileItem" }
    },
    "recontactProfileItems": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/profileItem" }
    },
    "certainty": {
      "type": "object",
      "required": ["CONFIRMED", "STRONG", "WEAK"],
      "additionalProperties": false,
      "properties": {
        "_설명": { "type": "string" },
        "CONFIRMED": { "type": "number", "minimum": 0, "maximum": 1 },
        "STRONG": { "type": "number", "minimum": 0, "maximum": 1 },
        "WEAK": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "generalDecay": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["maxDays", "factor"],
        "additionalProperties": false,
        "properties": {
          "_설명": { "type": "string" },
          "maxDays": { "type": ["integer", "null"], "minimum": 0, "description": "null이면 그 이상 전부" },
          "factor": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "recontactDates": {
      "type": "object",
      "required": ["reorderCycle", "nextContact"],
      "additionalProperties": false,
      "properties": {
        "_설명": { "type": "string" },
        "reorderCycle": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["maxAbsDays", "factor"],
            "additionalProperties": false,
            "properties": {
              "_설명": { "type": "string" },
              "maxAbsDays": { "type": ["integer", "null"], "minimum": 0 },
              "factor": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "nextContact": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["scheduledWithinDays", "pastWithinDays", "factor"],
            "additionalProperties": false,
            "properties": {
              "_설명": { "type": "string" },
              "scheduledWithinDays": { "type": ["integer", "null"], "minimum": 0 },
              "pastWithinDays": { "type": ["integer", "null"], "minimum": 0 },
              "factor": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "required": ["urgentE", "plannedE", "reviewE", "reviewP", "researchR", "watchRMin"],
      "additionalProperties": false,
      "properties": {
        "_설명": { "type": "string" },
        "urgentE": { "type": "integer", "minimum": 0, "maximum": 100 },
        "plannedE": { "type": "integer", "minimum": 0, "maximum": 100 },
        "reviewE": { "type": "integer", "minimum": 0, "maximum": 100 },
        "reviewP": { "type": "integer", "minimum": 0, "maximum": 100 },
        "researchR": { "type": "integer", "minimum": 0, "maximum": 100 },
        "watchRMin": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "rounding": {
      "type": "object",
      "required": ["itemScore", "display"],
      "additionalProperties": false,
      "properties": {
        "_설명": { "type": "string" },
        "itemScore": { "type": "string", "enum": ["HALF_UP_INT"] },
        "display": { "type": "string", "enum": ["ONE_DECIMAL"] }
      }
    },
    "coreEvidence": {
      "type": "object",
      "required": ["new", "recontact"],
      "additionalProperties": false,
      "properties": {
        "_설명": { "type": "string" },
        "new": { "$ref": "#/$defs/coreEvidenceRule" },
        "recontact": { "$ref": "#/$defs/coreEvidenceRule" }
      }
    },
    "timingRequirements": {
      "type": "object",
      "required": ["agreedWindowRequired"],
      "additionalProperties": false,
      "properties": {
        "_설명": { "type": "string" },
        "agreedWindowRequired": { "type": "boolean" }
      }
    },
    "researchRequirements": {
      "type": "object",
      "required": ["maxHoursDefault"],
      "additionalProperties": false,
      "properties": {
        "_설명": { "type": "string" },
        "maxHoursDefault": { "type": "number", "minimum": 0 }
      }
    },
    "classificationLabels": {
      "type": "object",
      "required": ["FILTER_EXCLUDED", "FILTER_PENDING", "OPS_PENDING", "NOT_EVALUATED", "CONTACT_URGENT", "CONTACT_PLANNED", "CONTACT_REVIEW", "RESEARCH", "CONDITIONAL_WAIT", "WATCH", "LOW"],
      "additionalProperties": false,
      "properties": {
        "_설명": { "type": "string" },
        "FILTER_EXCLUDED": { "type": "string", "minLength": 1 },
        "FILTER_PENDING": { "type": "string", "minLength": 1 },
        "OPS_PENDING": { "type": "string", "minLength": 1 },
        "NOT_EVALUATED": { "type": "string", "minLength": 1 },
        "CONTACT_URGENT": { "type": "string", "minLength": 1 },
        "CONTACT_PLANNED": { "type": "string", "minLength": 1 },
        "CONTACT_REVIEW": { "type": "string", "minLength": 1 },
        "RESEARCH": { "type": "string", "minLength": 1 },
        "CONDITIONAL_WAIT": { "type": "string", "minLength": 1 },
        "WATCH": { "type": "string", "minLength": 1 },
        "LOW": { "type": "string", "minLength": 1 }
      }
    },
    "otherGroupSort": {
      "type": "object",
      "required": ["default", "brochure"],
      "additionalProperties": false,
      "properties": {
        "_설명": { "type": "string" },
        "default": { "$ref": "#/$defs/sortKeys" },
        "brochure": { "$ref": "#/$defs/sortKeys" }
      }
    },
    "existingCustomerPlacement": {
      "type": "string",
      "enum": ["BOTTOM", "INLINE"],
      "default": "BOTTOM",
      "description": "PM 승인 2026-11-04, #262: BOTTOM은 기존 그룹 정렬 뒤 거래 중 기회만 맨 아래로 옮긴다. 각 묶음 안 순서는 유지한다. INLINE은 기존 그룹 정렬 그대로. 이전 설정 파일에서 생략해도 기본 BOTTOM."
    },
    "relationCheck": {
      "type": "string",
      "enum": ["BLOCK", "IGNORE"],
      "default": "BLOCK",
      "description": "PM 결정 2026-11-11, #567: BLOCK은 거래 관계 확인 전(UNCONFIRMED)이면 필터 대기·막는 조건(BR3.10, S06). IGNORE는 신규 잠재고객만 찾으므로 확인 전을 대기 사유로 쓰지 않는다. 거래 중(EXISTING_CONFIRMED) 정렬은 existingCustomerPlacement가 그대로 맡는다. 이전 설정 파일에서 생략하면 BLOCK."
    },
    "callSignals": {
      "type": "array",
      "default": [],
      "description": "PM 결정 2026-11-13, #685: 꼬리 질문 답 → 통화에서 확인한 신호 대응표. 항목 코드·배점은 그대로 두고 SIG_BID(구매·외주 의향)·SIG_HIRE(관심)를 통화 답으로 채운다. 대응표에 없는 답(아직 없음·관심 낮음·모름·무응답)은 신호를 만들지 않는다(0점 확정이 아니라 아직 모름). 통화 신호의 감쇠는 통화 날짜 기준 generalDecay 그대로. 이전 설정 파일에서 생략하면 빈 목록(통화 신호 없음).",
      "items": { "$ref": "#/$defs/callSignalRule" }
    },
    "datasetKinds": {
      "type": "array",
      "items": { "type": "string", "enum": ["VIRTUAL_REVIEWED", "BROCHURE", "COMPANY_CONFIRMED"] },
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true
    }
  },
  "$defs": {
    "profileItem": {
      "type": "object",
      "required": ["itemCode", "weight", "matchRateSteps", "decay"],
      "additionalProperties": false,
      "properties": {
        "_설명": { "type": "string" },
        "itemCode": { "type": "string", "pattern": "^[A-Z][A-Z_]+$" },
        "label": { "type": "string" },
        "weight": { "type": "integer", "minimum": 0, "maximum": 100 },
        "matchRateSteps": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "decay": { "type": "string", "enum": ["NONE", "GENERAL", "BID_EXCEPTION", "HIRE"] }
      }
    },
    "callSignalRule": {
      "type": "object",
      "required": ["itemCode", "signalKind", "answers"],
      "additionalProperties": false,
      "properties": {
        "_설명": { "type": "string" },
        "itemCode": { "type": "string", "pattern": "^[A-Z][A-Z_]+$", "description": "신규 프로필의 시점 항목 코드. 한 번씩만 적는다" },
        "signalKind": { "type": "string", "enum": ["CALL_INTENT", "CALL_INTEREST"], "description": "이 항목이 쓰는 통화 신호 종류. 한 번씩만 적는다" },
        "answers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["questionId", "answerId", "relation"],
            "additionalProperties": false,
            "properties": {
              "_설명": { "type": "string" },
              "questionId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,39}$", "description": "꼬리 질문 파일(sales-questions.yaml)의 질문 id" },
              "answerId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,39}$", "description": "그 질문의 보기 id" },
              "relation": { "type": "string", "enum": ["DIRECT", "INDIRECT"], "description": "DIRECT = 확인·직접 관련(배점 전부), INDIRECT = 확인·간접 관련(절반)" }
            }
          }
        }
      }
    },
    "coreEvidenceRule": {
      "type": "object",
      "required": ["items", "allowedStates", "requireReviewedCapability"],
      "additionalProperties": false,
      "properties": {
        "_설명": { "type": "string" },
        "items": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "allowedStates": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["CONFIRMED", "STRONG", "WEAK"] } },
        "requireReviewedCapability": { "type": "boolean" }
      }
    },
    "sortKeys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "order"],
        "additionalProperties": false,
        "properties": {
          "_설명": { "type": "string" },
          "key": { "type": "string", "enum": ["R", "E", "F", "P", "oppId"] },
          "order": { "type": "string", "enum": ["asc", "desc"] }
        }
      }
    }
  }
}
