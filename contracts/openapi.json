  "info": {
    "title": "거산 영업지원 API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/config/ui": {
      "get": {
        "operationId": "config_ui_api_v1_config_ui_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_ConfigUi_"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Config Ui"
      }
    },
    "/api/v1/opportunities": {
      "get": {
        "operationId": "list_opportunities_api_v1_opportunities_get",
        "parameters": [
          {
            "in": "query",
            "name": "tab",
            "required": false,
            "schema": {
              "default": "new",
              "title": "Tab",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 50,
              "minimum": 1,
              "title": "Pagesize",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_list_OpportunityCard__"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Opportunities"
      }
    },
    "/api/v1/opportunities/{oppId}": {
      "get": {
        "operationId": "opportunity_detail_api_v1_opportunities__oppId__get",
        "parameters": [
          {
            "in": "path",
            "name": "oppId",
            "required": true,
            "schema": {
              "title": "Oppid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_OpportunityDetail_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Opportunity Detail"
      }
    },
    "/api/v1/opportunities/{oppId}/opinions": {
      "post": {
        "operationId": "save_opinion_api_v1_opportunities__oppId__opinions_post",
        "parameters": [
          {
            "in": "path",
            "name": "oppId",
            "required": true,
            "schema": {
              "title": "Oppid",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Staff-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Staff-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpinionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_OpinionResponse_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Save Opinion"
      }
    },
    "/api/v1/session": {
      "post": {
        "operationId": "create_session_api_v1_session_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Session"
      }
    }
  }
}
